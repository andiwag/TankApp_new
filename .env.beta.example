# Copy these values to your Northflank service environment (never commit real secrets).
# Generate secrets: scripts/generate-beta-secrets.ps1  (or .sh on Linux/macOS)

DATABASE_URL=
# Link from Northflank Postgres addon POSTGRES_URI → alias DATABASE_URL

SECRET_KEY=
CRON_SECRET=
REGISTRATION_INVITE_CODE=

ENV=production
SINGLE_WORKER_MODE=true
RUN_MIGRATIONS_ON_START=true

# Your Northflank public URL, e.g. https://tankapp-web-xxxxx.code.run
BASE_URL=
ALLOWED_HOSTS=your-app.code.run

# Optional but recommended for password reset + maintenance reminders
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@yourdomain.com

# Optional error tracking
# SENTRY_DSN=
