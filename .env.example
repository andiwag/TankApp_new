DATABASE_URL=sqlite:///./dev.db

SECRET_KEY=supersecretkey

SESSION_COOKIE_NAME=tankly_session

ENV=development

# Public URL for password reset links (required in production when mail is enabled)
BASE_URL=

# Optional: shared rate limits across workers (required in production unless SINGLE_WORKER_MODE=true)
REDIS_URL=

# Set true only for single-worker beta deploys without Redis
SINGLE_WORKER_MODE=false

# Secret token for scheduled cron endpoints (required when ENV=production)
# Send as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# When set, registration requires this invite code (recommended for private beta)
REGISTRATION_INVITE_CODE=

# Comma-separated hostnames (e.g. your-app.code.run). Omit or use * for local dev.
ALLOWED_HOSTS=*

# Optional error tracking (https://sentry.io)
SENTRY_DSN=

# Set false when running scripts/migrate.sh as a one-off job before deploy
RUN_MIGRATIONS_ON_START=true

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@tankly.at
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_STARTTLS=true

# Comma-separated operator emails for /platform (empty = disabled)
# PLATFORM_ADMIN_EMAILS=you@example.com

# Stripe billing — set metadata.tier=pro|farm on each Price in Stripe Dashboard
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TRIAL_DAYS=14
# Optional overrides (defaults: tankly_pro_monthly, tankly_pro_yearly, …)
# STRIPE_LOOKUP_PRO_MONTHLY=tankly_pro_monthly
# STRIPE_LOOKUP_PRO_YEARLY=tankly_pro_yearly
# STRIPE_LOOKUP_FARM_MONTHLY=tankly_farm_monthly
# STRIPE_LOOKUP_FARM_YEARLY=tankly_farm_yearly

# Legal pages (required before paid launch)
COMPANY_LEGAL_NAME=
COMPANY_STREET=
COMPANY_CITY=
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_UID=
COMPANY_REGISTER=
COMPANY_REGISTER_COURT=
COMPANY_TRADE_AUTHORITY=
COMPANY_JURISDICTION=Wien
HOSTING_PROVIDER=Northflank
MAIL_PROVIDER=Brevo
